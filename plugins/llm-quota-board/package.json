{
  "name": "dsh-quota",
  "version": "0.1.0",
  "type": "module",
  "description": "Quota overview for every provider and model deployed in Settings -> Models",
  "author": "xypshot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xypshot/dsh-plugins.git",
    "directory": "plugins/llm-quota-board"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 || >=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
